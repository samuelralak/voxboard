{
  "name": "@voxboard/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Nostr event model for Voxboard: typed builders/parsers + Zod validation. The single source of truth for how boards/ideas/votes/status are encoded. Consumed by apps/web and apps/indexer.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./kinds": "./src/kinds.ts",
    "./coords": "./src/coords.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "light-bolt11-decoder": "3.2.0",
    "nostr-tools": "2.23.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
